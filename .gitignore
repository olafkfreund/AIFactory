# ===========================
# Security - Environment & Secrets
# ===========================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
# Allowlist: SAML test fixtures (deliberately committed low-security
# self-signed keys — see tests/fixtures/saml/README.md).
!tests/fixtures/saml/*.crt
!tests/fixtures/saml/*.key
.secrets
secrets/
credentials/
# Explicit allow for the P2 EncryptedString / KMS test directory —
# the generic `secrets/` rule above is for credential dumps, not our
# pytest module path. Must come AFTER the broad rule it overrides.
!tests/secrets/
!tests/secrets/**

