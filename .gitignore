# ===========================
# Helm sub-chart cache (Epic #35 #38)
# ===========================
# `helm dep update` writes Chart.lock + pulled .tgz files under
# charts/aifactory/charts/. We commit Chart.yaml (the source of truth
# for pinning) and let CI re-pull on every run. Same posture as
# package-lock.json being source-of-truth while node_modules/ isn't.
charts/aifactory/Chart.lock
charts/aifactory/charts/
# Ignore everything directly under .claude/ EXCEPT the project-scope skills
# directory (Issue #9). `.claude/*` (no trailing slash) is required for the
# `!exception` pattern to take effect — git stops descending into a fully-
# excluded `.claude/` directory and never sees inner negations.
.claude/*
!.claude/skills/
# Note: the legacy /docs ignore was removed when the Docusaurus site
# was added at docs/.  Build outputs are still ignored via docs/.gitignore.
OPUS_ANALYSIS_AND_IDEAS.md
/.github/agents
.gitfilter-replacements.txt

# local devenv generated cache
.devenv/

# local direnv env (holds secrets — never commit)
.envrc
.direnv/
