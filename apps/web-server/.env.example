# MagesticAI Web Server Configuration
# Copy this file to .env and modify as needed

# Server settings
APP_HOST=0.0.0.0
APP_PORT=3101
APP_DEBUG=true

# Authentication
# If not set, a token will be auto-generated on first run
# APP_API_TOKEN=your-secure-token-here

# CORS origins — accepts a comma-separated list OR a JSON array.
# Examples:
#   APP_CORS_ORIGINS=https://app.example.com,https://api.example.com
#   APP_CORS_ORIGINS=["http://localhost:3100","http://localhost:3000"]
# Defaults already cover http(s)://localhost:{3000,3100,3101}.
# APP_CORS_ORIGINS=

# Paths (auto-detected if not set)
# APP_BACKEND_PATH=/path/to/apps/backend
# APP_PROJECTS_DATA_DIR=/path/to/data/directory

# Terminal settings
APP_DEFAULT_SHELL=/bin/bash
APP_MAX_TERMINALS=20

# Task execution
APP_MAX_CONCURRENT_TASKS=5

# rmux Live Agent Console (Epic #44) — set true to show the "Agent Console"
# tab in the task view (streams the agent working live). Requires the rmux
# binary on PATH; tasks fall back to PTY safely if it's missing. Recommended
# on for local dev. Keep OFF on the bank-pilot image (WITH_RMUX=false).
# (Also honored: the AIFACTORY_RMUX_ENABLED process env var.)
APP_RMUX_ENABLED=true

# PFactory → TFactory outbound transport (epic #327 / #337). When a governed
# PFactory child routes to TFactory (handoff:tfactory / type:testing), the
# task-start route POSTs the spec + pfactory:meta here for test generation.
# Leave TFACTORY_BASE_URL unset to disable (routing still records a local
# TFACTORY_HANDOFF.md marker; nothing is sent).
# TFACTORY_BASE_URL=https://tfactory.internal
# TFACTORY_TOKEN=
# TFACTORY_HANDOFF_PATH=/api/handoff

# RFC-0001 completion-event emission (PARR spine, Factory#1 / #342). When a task
# reaches a terminal build state (completed / failed) or is marked "done", the
# web-server emits a normalized completion event so the cockpit (CFactory) can
# thread the unit of work end to end by correlation_key. Both channels are
# opt-in and best-effort — a missing/failing target never breaks the pipeline.
# AIFACTORY_COMPLETION_WEBHOOK=http://localhost:3110/api/events/completion
# AIFACTORY_COMPLETION_WEBHOOK_TIMEOUT=5
# AIFACTORY_COMPLETION_SENTINEL=1   # also write <spec_dir>/COMPLETED.json
