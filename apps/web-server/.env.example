# MagesticAI Web Server Configuration
# Copy this file to .env and modify as needed

# Server settings
APP_HOST=0.0.0.0
APP_PORT=3101
APP_DEBUG=true

# Authentication
# If not set, a token will be auto-generated on first run
# APP_API_TOKEN=your-secure-token-here

# CORS origins — accepts a comma-separated list OR a JSON array.
# Examples:
#   APP_CORS_ORIGINS=https://app.example.com,https://api.example.com
#   APP_CORS_ORIGINS=["http://localhost:3100","http://localhost:3000"]
# Defaults already cover http(s)://localhost:{3000,3100,3101}.
# APP_CORS_ORIGINS=

# Paths (auto-detected if not set)
# APP_BACKEND_PATH=/path/to/apps/backend
# APP_PROJECTS_DATA_DIR=/path/to/data/directory

# Terminal settings
APP_DEFAULT_SHELL=/bin/bash
APP_MAX_TERMINALS=20

# Task execution
APP_MAX_CONCURRENT_TASKS=5

# rmux Live Agent Console (Epic #44) — set true to show the "Agent Console"
# tab in the task view (streams the agent working live). Requires the rmux
# binary on PATH; tasks fall back to PTY safely if it's missing. Recommended
# on for local dev. Keep OFF on the bank-pilot image (WITH_RMUX=false).
# (Also honored: the AIFACTORY_RMUX_ENABLED process env var.)
APP_RMUX_ENABLED=true

# PFactory → TFactory outbound transport (epic #327 / #337). When a governed
# PFactory child routes to TFactory (handoff:tfactory / type:testing), the
# task-start route POSTs the spec + pfactory:meta here for test generation.
# Leave TFACTORY_BASE_URL unset to disable (routing still records a local
# TFACTORY_HANDOFF.md marker; nothing is sent).
# TFACTORY_BASE_URL=https://tfactory.internal
# TFACTORY_TOKEN=
# TFACTORY_HANDOFF_PATH=/api/handoff

# RFC-0001 completion-event emission (PARR spine, Factory#1 / #342). When a task
# reaches a terminal build state (completed / failed) or is marked "done", the
# web-server emits a normalized completion event so the cockpit (CFactory) can
# thread the unit of work end to end by correlation_key. Both channels are
# opt-in and best-effort — a missing/failing target never breaks the pipeline.
# Values in .env are loaded into os.environ at startup (see server/env_bootstrap.py).
# CFactory's event ingress is :3111/api/events (the cockpit backend).
# AIFACTORY_COMPLETION_WEBHOOK=http://localhost:3111/api/events
# AIFACTORY_COMPLETION_WEBHOOK_TIMEOUT=5
# AIFACTORY_COMPLETION_SENTINEL=1   # also write <spec_dir>/COMPLETED.json

# =============================================================================
# See docs/docs/environment-reference.md for the COMPLETE variable reference.
# Everything below is OPTIONAL with safe defaults — uncomment to override.
# =============================================================================

# --- Control plane -----------------------------------------------------------
# APP_DATABASE_URL=                 # default: sqlite in the data dir; set Postgres for multi-replica
# APP_MIGRATIONS_AUTO_APPLY=true    # false in K8s where a Helm Job migrates out-of-band
# APP_MAX_CONCURRENT_TASKS=5        # global cap on running builds; <=0 = unlimited
# APP_AGENT_MONITOR_SYNC_INTERVAL=3.0
# APP_AGENT_MAX_CONTINUATION_ROUNDS=10
# APP_DISABLE_AUTH=false            # dev only; refused on non-loopback host without APP_DEBUG
# APP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# APP_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# APP_SSL_ENABLED=false
# APP_SSL_CERTFILE=
# APP_SSL_KEYFILE=
# APP_SKILLS_PATH=
# APP_FILE_BROWSE_ROOTS=

# --- Multi-replica fan-out + workspace object storage ------------------------
# APP_REDIS_URL=                    # empty = in-process only (single replica)
# APP_REDIS_CHANNEL=aifactory:events
# APP_WORKSPACE_S3_URI_BASE=        # s3://... gs://... azure://... enables snapshot/restore
# AIFACTORY_S3_ENDPOINT_URL=        # fsspec WorkspaceStore custom endpoint (MinIO)
# AIFACTORY_S3_ADDRESSING_STYLE=path

# --- Federated cockpit search (#149) -----------------------------------------
# APP_CFACTORY_SEARCH_URL=http://cfactory.factory.svc.cluster.local:3111
# APP_CFACTORY_READ_KEY=            # empty = feature off

# --- Build backend / job-native scheduling -----------------------------------
# AIFACTORY_BUILD_BACKEND=subprocess   # or 'kubejob'
# AIFACTORY_BUILD_IMAGE=               # override build-Job image (point at :sha-<short>-nix)
# AIFACTORY_IMAGE=                     # running image (fallback build-Job image)
# AIFACTORY_PACK_WORKSPACE=            # pack /work to object storage (removes workspace node-pin)
# AIFACTORY_PACKED_NIX_IN_IMAGE=       # resolve /nix from image (removes last node-pin)
# AIFACTORY_DATA_ROOT=/home/nonroot/.aifactory
# AIFACTORY_SANDBOX_NAMESPACE=factory
# AIFACTORY_BUILD_SA=aifactory-sandbox
# AIFACTORY_BUILD_DEADLINE_SECONDS=21600
# AIFACTORY_SANDBOX_REPO_PVC=aifactory-data
# AIFACTORY_NIX_STORE_PVC=
# AIFACTORY_CLI_CREDS_SECRET=

# --- Intake poller -----------------------------------------------------------
# AIFACTORY_INTAKE_POLLER=            # enable background issue-intake poller
# AIFACTORY_INTAKE_REPOS=             # comma-separated repos to watch
# AIFACTORY_INTAKE_INTERVAL_S=30
# AIFACTORY_INTAKE_REQUEUE_AFTER_S=600
# AIFACTORY_INTAKE_AUTO_HANDOFF=
# AIFACTORY_INTAKE_PARALLEL=          # fleet default: unlabelled issues build in parallel waves
# AIFACTORY_INTAKE_WORKERS=
# AIFACTORY_INTAKE_DB=
# AIFACTORY_TOKEN=                    # poller API token (falls back to APP_API_TOKEN)
# AIFACTORY_URL=
# PFACTORY_TOKEN=
# PFACTORY_INGEST_URL=

# --- PR endgame / deploy / Copilot -------------------------------------------
# AIFACTORY_AUTO_PR=
# AIFACTORY_AUTO_MERGE=               # requires AIFACTORY_AUTO_PR
# AIFACTORY_PR_REVIEWER=aifactory     # aifactory | copilot | any
# AIFACTORY_AUTO_DEPLOY=
# AIFACTORY_COPILOT_DISPATCH_ENABLED=

# --- Completion outbox / event source ----------------------------------------
# AIFACTORY_COMPLETION_OUTBOX=        # durable retry queue for completion events
# AIFACTORY_COMPLETION_OUTBOX_DB=
# AIFACTORY_EVENT_SOURCE=/aifactory
# AIFACTORY_WORKER_PROGRESS_INTERVAL_S=

# --- MCP control plane -------------------------------------------------------
# AIFACTORY_MCP_REMOTE_ENABLED=       # expose /api/mcp-remote/sse
# AIFACTORY_MCP_LOOPBACK_URL=http://localhost:3101
# AIFACTORY_MCP_SECRET=               # Copilot MCP shared secret

# --- Live Console (rmux) — APP_RMUX_ENABLED is set above ----------------------
# AIFACTORY_RMUX_PANES_DIR=

# --- Security & sandbox ------------------------------------------------------
# AIFACTORY_AGENT_SANDBOX=off         # OS-level agent sandbox
# AIFACTORY_AGENT_SANDBOX_PIDNS=
# AIFACTORY_SANDBOX_BACKEND=docker    # docker | nixjob
# AIFACTORY_SANDBOX_GATES=
# AIFACTORY_SANDBOX_IMAGE=
# AIFACTORY_SANDBOX_NETWORK=none
# METRICS_SCRAPE_TOKEN=               # gate the /metrics endpoint

# --- Observability -----------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=        # set enables OpenTelemetry export
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=aifactory-web

