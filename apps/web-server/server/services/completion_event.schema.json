{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.dev/schemas/rfc-0001/completion-event-1.3.json",
  "title": "Factory RFC-0001 completion event (v1.3, per-worker usage + live sub-events)",
  "description": "AIFactory completion events. v1.3 (#45 P1) additively (a) extends the terminal event's usage block with a per-worker breakdown (usage.workers[]) and by_provider{} / by_model{} rollups (scalar usage fields kept for back-compat), and (b) adds a LIVE per-worker sub-event with phase:\"worker\", status:\"worker_done\", and an additive top-level worker{} object emitted as each parallel/serial worker finishes. v1.2 (#466) added a per-event idempotency id, CloudEvents-core fields, and W3C trace context alongside the legacy RFC-0001 fields. additionalProperties is permitted so the envelope can keep growing additively without breaking validation; the worker object and the new usage fields are optional, so old producers/consumers still validate.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "correlation_key",
    "service",
    "task_id",
    "status",
    "phase",
    "updated_at",
    "id",
    "specversion",
    "source",
    "type",
    "time",
    "traceparent"
  ],
  "properties": {
    "correlation_key": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "const": "aifactory" },
    "task_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "event": { "type": "string" },
    "schema_version": { "type": "string" },
    "correlation": {
      "type": "object",
      "properties": {
        "issue_number": { "type": ["integer", "null"] },
        "spec_id": { "type": ["string", "null"] },
        "project_id": { "type": ["string", "null"] }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "specversion": { "type": "string", "const": "1.0" },
    "source": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": { "type": "string" },
    "worker": {
      "type": "object",
      "description": "Per-worker (per-subtask) record carried by a LIVE sub-event (phase:\"worker\", status:\"worker_done\") emitted as that worker finishes (v1.3, #45 P1). Additive and optional; absent on the terminal event and for old producers. Dedup key for consumers: (service, correlation_key, worker.worker_id).",
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "subtask_id": { "type": ["string", "null"] },
        "agent_phase": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "cost_usd": { "type": "number" },
        "duration_ms": { "type": "integer" }
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "cost_usd": { "type": "number" },
        "model": { "type": ["string", "null"] },
        "workers": {
          "type": "array",
          "description": "Per-worker (per-subtask) usage breakdown (v1.3, #45 P1). Additive; absent for old producers. A serial single-model task carries one implicit 'main' worker.",
          "items": {
            "type": "object",
            "properties": {
              "worker_id": { "type": "string" },
              "phase": { "type": ["string", "null"] },
              "subtask_id": { "type": ["string", "null"] },
              "provider": { "type": ["string", "null"] },
              "model": { "type": ["string", "null"] },
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" },
              "cost_usd": { "type": "number" },
              "duration_ms": { "type": "integer" }
            }
          }
        },
        "by_provider": {
          "type": "object",
          "description": "Token/cost rollup keyed by provider, derived from workers[] (v1.3, #45 P1). Additive.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" },
              "cost_usd": { "type": "number" },
              "workers": { "type": "integer" }
            }
          }
        },
        "by_model": {
          "type": "object",
          "description": "Token/cost rollup keyed by model, derived from workers[] (v1.3, #45 P1). Additive.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" },
              "cost_usd": { "type": "number" },
              "workers": { "type": "integer" }
            }
          }
        },
        "budget": {
          "type": "object",
          "description": "Soft budget alert (v1.3, #45 P2). Present only when the contract set execution.budget_usd. OBSERVE-ONLY: a warning surface comparing the rolled-up spend against the budget; the build is NEVER aborted. Additive and optional; omitted when no budget is set.",
          "required": ["limit_usd", "spent_usd", "exceeded"],
          "properties": {
            "limit_usd": { "type": "number" },
            "spent_usd": { "type": "number" },
            "exceeded": { "type": "boolean" }
          }
        }
      }
    }
  }
}
