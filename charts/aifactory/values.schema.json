{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "AIFactory Helm chart values",
  "type": "object",
  "required": [
    "image",
    "replicaCount"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "jobSandbox": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "migrations": {
      "type": "object",
      "properties": {
        "autoApply": {
          "type": "boolean"
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "bundled": {
          "type": "boolean"
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backend": {
          "enum": [
            "vault",
            "aws-sm",
            "azure-kv",
            "gcp-sm"
          ]
        }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "keycloak",
            "okta",
            "azure_ad"
          ]
        }
      }
    },
    "saml": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "spEntityId": {
          "type": "string"
        },
        "acsUrl": {
          "type": "string"
        },
        "idpMetadataUrl": {
          "type": "string"
        },
        "idpMetadataSecretName": {
          "type": "string"
        },
        "idpName": {
          "type": "string"
        },
        "idpDisplayName": {
          "type": "string"
        },
        "spCertSecretName": {
          "type": "string"
        },
        "requireEncryptedAssertion": {
          "type": "boolean"
        },
        "idpInitDefaultReturnTo": {
          "type": "string"
        },
        "slo": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "idpSloUrl": {
              "type": "string"
            },
            "slsUrl": {
              "type": "string"
            }
          }
        }
      }
    },
    "scim": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tokenSecretName": {
          "type": "string"
        }
      }
    },
    "kms": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "fernet",
            "aws_kms",
            "vault_transit",
            "azure_kv",
            "gcp_kms"
          ]
        }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "protocol": {
          "enum": [
            "grpc",
            "http/protobuf"
          ]
        },
        "serviceName": {
          "type": "string"
        },
        "samplingRatio": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "headersSecretName": {
          "type": "string"
        }
      }
    },
    "audit": {
      "type": "object",
      "properties": {
        "anchor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "scheduler": {
              "enum": [
                "cronjob",
                "in-process"
              ]
            },
            "cron": {
              "type": "object",
              "properties": {
                "schedule": {
                  "type": "string"
                },
                "activeDeadlineSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "backoffLimit": {
                  "type": "integer",
                  "minimum": 0
                },
                "successfulJobsHistoryLimit": {
                  "type": "integer",
                  "minimum": 0
                },
                "failedJobsHistoryLimit": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "claude": {
      "type": "object",
      "properties": {
        "enforcement": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "failureMode": {
              "enum": [
                "open",
                "closed"
              ]
            }
          }
        }
      }
    },
    "litellm": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "masterKeySecretName": {
          "type": "string"
        },
        "gatewayUrl": {
          "type": "string"
        },
        "audit": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "fullTextCapture": {
              "type": "boolean"
            },
            "failureMode": {
              "enum": [
                "closed",
                "open"
              ]
            },
            "extraRedactionPatterns": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "pattern",
                  "replacement"
                ],
                "properties": {
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replacement": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "masterKeySecretName"
            ],
            "properties": {
              "masterKeySecretName": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "audit": {
                "properties": {
                  "fullTextCapture": {
                    "const": true
                  }
                },
                "required": [
                  "fullTextCapture"
                ]
              }
            },
            "required": [
              "audit"
            ]
          },
          "then": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "grafanaDashboards": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaceLabel": {
              "type": "string"
            },
            "folder": {
              "type": "string"
            }
          }
        }
      }
    },
    "tenant": {
      "type": "object",
      "properties": {
        "isolationEnabled": {
          "type": "boolean"
        },
        "deletionGraceDays": {
          "type": "integer",
          "minimum": 0,
          "description": "Days between soft-delete and infra tear-down. 0 disables the grace window (operator gets a WARNING on every reconcile pass)."
        },
        "namespacePrefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,40}[a-z0-9]$",
          "description": "DNS-label-safe prefix. Constrained so the final ``<prefix>-<slug>`` namespace stays under the 63-char DNS limit."
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "cniBackend": {
              "enum": [
                "auto",
                "calico",
                "cilium"
              ]
            }
          }
        },
        "limitRange": {
          "type": "object",
          "properties": {
            "defaultCpu": {
              "type": "string"
            },
            "defaultMemory": {
              "type": "string"
            }
          }
        },
        "resourceQuota": {
          "type": "object",
          "properties": {
            "maxPods": {
              "type": "integer",
              "minimum": 1
            },
            "maxPvcs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "gatekeeperEnabled": {
          "type": "boolean"
        },
        "teardown": {
          "type": "object",
          "properties": {
            "cronSchedule": {
              "type": "string"
            },
            "dryRunHours": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "customCABundle": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
