#!/bin/sh

echo "Running pre-commit checks..."

# =============================================================================
# VERSION SYNC - Keep all version references in sync with root package.json
# =============================================================================

# Check if package.json is staged
if git diff --cached --name-only | grep -q "^package.json$"; then
  echo "package.json changed, syncing version to all files..."

  # Extract version from root package.json
  VERSION=$(node -p "require('./package.json').version")

  if [ -n "$VERSION" ]; then
    # Sync to apps/frontend/package.json
    if [ -f "apps/frontend/package.json" ]; then
      node -e "
        const fs = require('fs');
        const pkg = require('./apps/frontend/package.json');
        if (pkg.version !== '$VERSION') {
          pkg.version = '$VERSION';
          fs.writeFileSync('./apps/frontend/package.json', JSON.stringify(pkg, null, 2) + '\n');
          console.log('  Updated apps/frontend/package.json to $VERSION');
        }
      "
      git add apps/frontend/package.json
    fi

    # Sync to apps/backend/__init__.py
    if [ -f "apps/backend/__init__.py" ]; then
      sed -i.bak "s/__version__ = \"[^\"]*\"/__version__ = \"$VERSION\"/" apps/backend/__init__.py
      rm -f apps/backend/__init__.py.bak
      git add apps/backend/__init__.py
      echo "  Updated apps/backend/__init__.py to $VERSION"
    fi

    # Sync to README.md - section-aware updates (stable vs beta)
    if [ -f "README.md" ]; then
      # Escape hyphens for shields.io badge format (shields.io uses -- for literal hyphens)
      ESCAPED_VERSION=$(echo "$VERSION" | sed 's/-/--/g')

      # Detect if this is a prerelease (contains - after base version, e.g., 2.7.2-beta.10)
      if echo "$VERSION" | grep -q '-'; then
        # PRERELEASE: Update only beta sections
        echo "  Detected PRERELEASE version: $VERSION"

        # Update beta version badge (orange)
        sed -i.bak "s/beta-[0-9]*\.[0-9]*\.[0-9]*\(--[a-z]*\.[0-9]*\)*-orange/beta-$ESCAPED_VERSION-orange/g" README.md

        # Update beta version badge link (within BETA_VERSION_BADGE section)
        sed -i.bak '/<!-- BETA_VERSION_BADGE -->/,/<!-- BETA_VERSION_BADGE_END -->/s|releases/tag/v[0-9.a-z-]*)|releases/tag/v'"$VERSION"')|g' README.md

        # Update beta download links (within BETA_DOWNLOADS section only)
        for SUFFIX in "win32-x64.exe" "darwin-arm64.dmg" "darwin-x64.dmg" "linux-x86_64.AppImage" "linux-amd64.deb" "linux-x86_64.flatpak"; do
          sed -i.bak '/<!-- BETA_DOWNLOADS -->/,/<!-- BETA_DOWNLOADS_END -->/{s|AIFactory-[0-9.a-z-]*-'"$SUFFIX"'](https://github.com/dataseeek/AIFactory/releases/download/v[^/]*/AIFactory-[^)]*-'"$SUFFIX"')|AIFactory-'"$VERSION"'-'"$SUFFIX"'](https://github.com/dataseeek/AIFactory/releases/download/v'"$VERSION"'/AIFactory-'"$VERSION"'-'"$SUFFIX"')|g}' README.md
        done
      else
        # STABLE: Update stable sections and top badge
        echo "  Detected STABLE version: $VERSION"

        # Update top version badge (blue) - within TOP_VERSION_BADGE section
        sed -i.bak '/<!-- TOP_VERSION_BADGE -->/,/<!-- TOP_VERSION_BADGE_END -->/s/version-[0-9]*\.[0-9]*\.[0-9]*\(--[a-z]*\.[0-9]*\)*-blue/version-'"$ESCAPED_VERSION"'-blue/g' README.md
        sed -i.bak '/<!-- TOP_VERSION_BADGE -->/,/<!-- TOP_VERSION_BADGE_END -->/s|releases/tag/v[0-9.a-z-]*)|releases/tag/v'"$VERSION"')|g' README.md

        # Update stable version badge (blue) - within STABLE_VERSION_BADGE section
        sed -i.bak '/<!-- STABLE_VERSION_BADGE -->/,/<!-- STABLE_VERSION_BADGE_END -->/s/stable-[0-9]*\.[0-9]*\.[0-9]*\(--[a-z]*\.[0-9]*\)*-blue/stable-'"$ESCAPED_VERSION"'-blue/g' README.md
        sed -i.bak '/<!-- STABLE_VERSION_BADGE -->/,/<!-- STABLE_VERSION_BADGE_END -->/s|releases/tag/v[0-9.a-z-]*)|releases/tag/v'"$VERSION"')|g' README.md

        # Update stable download links (within STABLE_DOWNLOADS section only)
        for SUFFIX in "win32-x64.exe" "darwin-arm64.dmg" "darwin-x64.dmg" "linux-x86_64.AppImage" "linux-amd64.deb"; do
          sed -i.bak '/<!-- STABLE_DOWNLOADS -->/,/<!-- STABLE_DOWNLOADS_END -->/{s|AIFactory-[0-9.a-z-]*-'"$SUFFIX"'](https://github.com/dataseeek/AIFactory/releases/download/v[^/]*/AIFactory-[^)]*-'"$SUFFIX"')|AIFactory-'"$VERSION"'-'"$SUFFIX"'](https://github.com/dataseeek/AIFactory/releases/download/v'"$VERSION"'/AIFactory-'"$VERSION"'-'"$SUFFIX"')|g}' README.md
        done
      fi

      rm -f README.md.bak
      git add README.md
      echo "  Updated README.md to $VERSION"
    fi

    echo "Version sync complete: $VERSION"
  fi
fi

# =============================================================================
# BACKEND CHECKS (Python) - Run first, before frontend
# =============================================================================

# Check if there are staged Python files in apps/backend
if git diff --cached --name-only | grep -q "^apps/backend/.*\.py$"; then
  echo "Python changes detected, running backend checks..."

  if [ "${AIFACTORY_SKIP_PYTHON_GATE:-0}" = "1" ]; then
    echo "AIFACTORY_SKIP_PYTHON_GATE=1 set: SKIPPING the Python quality gate."
    echo "This commit's Python changes are NOT checked; CI will still gate the PR."
  else
    # Resolve each tool from the repo venv first, then PATH. -x (not -f) so a
    # dangling venv symlink (nix-GC'd store path) falls through to PATH.
    resolve_tool() {
      for cand in "apps/backend/.venv/bin/$1" "apps/backend/.venv/Scripts/$1.exe"; do
        if [ -x "$cand" ]; then
          echo "$cand"
          return
        fi
      done
      command -v "$1" || true
    }

    RUFF=$(resolve_tool ruff)
    MYPY=$(resolve_tool mypy)
    PYTHON=$(resolve_tool python3)
    MISSING=""
    [ -n "$RUFF" ] || MISSING="$MISSING ruff"
    [ -n "$MYPY" ] || MISSING="$MISSING mypy"
    [ -n "$PYTHON" ] || MISSING="$MISSING python3"

    # A gate that cannot run must FAIL, never silently pass (#1084).
    if [ -n "$MISSING" ]; then
      echo "ERROR: cannot run the Python quality gate; missing:$MISSING"
      echo "Looked in apps/backend/.venv/bin, apps/backend/.venv/Scripts, and PATH."
      echo "Fix: cd apps/backend && uv venv && uv pip install ruff mypy"
      echo "Deliberate one-off skip: AIFACTORY_SKIP_PYTHON_GATE=1 git commit ..."
      exit 1
    fi

    # A pin is only a pin if the tool that RUNS is the tool that was pinned
    # (#1162). resolve_tool takes whatever ruff is installed, so the three
    # places this repo writes the version down (cq-ratchet.yml RUFF_VERSION,
    # .pre-commit-config.yaml's ruff-pre-commit rev, tests/requirements-test.txt)
    # said nothing about what this hook actually executed. Measured on a
    # developer machine while #1162 was open: venv 0.15.14, PATH 0.15.17, CI
    # 0.14.10 -- three ruffs, one of them CI's.
    #
    # That is not cosmetic here, because the block below does not merely CHECK
    # formatting, it REWRITES staged files with this ruff and `git add`s the
    # result. A formatter two minors off CI's lands a diff nobody intended and
    # CI then rejects it, with the blame landing on the change rather than the
    # toolchain (PFactory#452, same hook lineage).
    #
    # The pin is READ from the workflow rather than restated, so there is no
    # fourth copy to forget; tests/test_ruff_pin_agreement.py runs this exact
    # line against the real workflow so a reformat that breaks the match is
    # caught by CI rather than by this hook going quiet.
    RUFF_PIN=$(sed -n 's/^[[:space:]]*RUFF_VERSION:[[:space:]]*"\{0,1\}\([0-9][^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' .github/workflows/cq-ratchet.yml | head -1)
    RUFF_HAVE=$("$RUFF" --version 2>/dev/null | sed -n 's/^ruff \([0-9][^ ]*\).*$/\1/p')

    # A gate that cannot run must FAIL, never silently pass (#1084) -- an empty
    # pin here means the sed stopped matching, which is the gate going quiet.
    if [ -z "$RUFF_PIN" ]; then
      echo "ERROR: could not read RUFF_VERSION from .github/workflows/cq-ratchet.yml."
      echo "The hook cannot confirm it runs the same ruff as CI, so it will not guess."
      exit 1
    fi

    if [ "$RUFF_HAVE" != "$RUFF_PIN" ]; then
      echo "ERROR: this hook would run ruff ${RUFF_HAVE:-<unknown>} while CI pins $RUFF_PIN."
      echo "Resolved: $RUFF"
      echo "Formatting rules change between ruff minors, so the hook would rewrite"
      echo "your staged files with a formatter CI then disagrees with."
      echo "Fix: cd apps/backend && uv pip install 'ruff==$RUFF_PIN'"
      echo "Deliberate one-off skip: AIFACTORY_SKIP_PYTHON_GATE=1 git commit ..."
      exit 1
    fi

    # Same gate as CI (.github/workflows/cq-ratchet.yml): the diff-scoped
    # per-file no-regression ratchet under the shared strict configs.
    # Pre-existing debt in a touched file is allowed; net-new violations fail.
    echo "Running cq ratchet (ruff, staged vs HEAD)..."
    "$PYTHON" scripts/cq_ratchet.py --staged --ruff "$RUFF" \
      --config standards/ruff.toml --paths 'apps/backend/*.py' || exit 1

    echo "Running cq ratchet (mypy, staged vs HEAD)..."
    "$PYTHON" scripts/cq_ratchet.py --staged --tool mypy --mypy "$MYPY" \
      --config standards/mypy.ini --paths 'apps/backend/*.py' || exit 1

    # Mirror CI's repo-wide `ruff format --check` by auto-formatting the
    # staged files and re-staging them.
    STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^apps/backend/.*\.py$" || true)
    if [ -n "$STAGED_PY_FILES" ]; then
      echo "Running ruff format on staged files..."
      # --force-exclude is load-bearing (Factory#431). ruff formats a file named
      # EXPLICITLY on the command line even when ruff.toml excludes it, and this
      # hook always names files explicitly. Without the flag the hook reformatted
      # apps/backend/runners/github/ -- the byte-exact factory-github mirror that
      # ruff.toml excludes precisely so it cannot be reformatted -- and then
      # `git add`ed the result. CI's `ruff format --check apps/backend` WALKS the
      # tree and so honours the exclusion, meaning the hook and CI disagreed and
      # only the hook could corrupt the vendored copy. The drift gate then fails
      # on the next re-vendor and the blame lands on the re-vendor, not here.
      echo "$STAGED_PY_FILES" | xargs "$RUFF" format --force-exclude || exit 1
      echo "$STAGED_PY_FILES" | xargs git add
    fi
  fi

  # pytest is deliberately NOT run here: CI runs the full suite, and a
  # multi-minute hook gets bypassed with --no-verify as surely as a wrong one
  # (#1084). The ratchet above is the fast, CI-identical commit gate.

  echo "Backend checks passed!"
fi

# =============================================================================
# FRONTEND CHECKS (TypeScript/React)
# =============================================================================

# Check if there are staged files in apps/frontend
if git diff --cached --name-only | grep -q "^apps/frontend/"; then
  echo "Frontend changes detected, running frontend checks..."
  cd apps/frontend

  # Run lint-staged (handles staged .ts/.tsx files)
  npm exec lint-staged
  if [ $? -ne 0 ]; then
    echo "lint-staged failed. Please fix linting errors before committing."
    exit 1
  fi

  # Run TypeScript type check
  echo "Running type check..."
  npm run typecheck
  if [ $? -ne 0 ]; then
    echo "Type check failed. Please fix TypeScript errors before committing."
    exit 1
  fi

  # Run linting
  echo "Running lint..."
  npm run lint
  if [ $? -ne 0 ]; then
    echo "Lint failed. Run 'npm run lint:fix' to auto-fix issues."
    exit 1
  fi

  # Check for vulnerabilities (only high severity)
  echo "Checking for vulnerabilities..."
  npm audit --audit-level=high
  if [ $? -ne 0 ]; then
    echo "High severity vulnerabilities found. Run 'npm audit fix' to resolve."
    exit 1
  fi

  cd ../..
  echo "Frontend checks passed!"
fi

echo "All pre-commit checks passed!"
