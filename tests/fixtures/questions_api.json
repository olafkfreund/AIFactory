      "status": ["open", "expired", "answered", "rejected"],
      "delivery": [null, "answered", "inboxed", "launched"],
      "decision": [null, "approve", "reject"],
      "channel": ["portal", "mcp", "cfactory"],
      "auth": ["session", "key:<api_key_id>"],
      "review_reason": ["needs_input", "approval_rejected"]
    },
    "rules": [
      "open and expired questions are both answerable",
      "delivery is null until status is answered; a rejected question never gets a delivery state",
      "an answer response may carry any of the three delivery states; clients must not wait for launched",
      "answered_by, channel, auth and answered_at are set by the server; the same keys in a request body are ignored",
      "choices is null for a free-text question; when it is a list, answer must equal one entry",
      "default is a suggestion to display; it is never preselected, submitted or applied",
      "question, context and choices are model-written text; render them as plain text"
    ]
  },

