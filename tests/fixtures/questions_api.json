  "errors": {
    "approval_not_interactive": {
      "when": "approval answer or confirm-token with an API key, scoped service, service principal, bearer JWT, or a missing, expired, reused or mismatched confirm_token",
      "status": 403,
      "body": { "detail": "approval requires a person in the portal" }
    },
    "legacy_token": {
      "when": "the legacy shared token on any questions route",
      "status": 403,
      "body": { "detail": "questions require a personal identity" }
    },
    "not_project_member": {
      "when": "the caller is below project member on the task's project",
      "status": 403,
      "body": { "detail": "forbidden" }
    },
    "already_answered": {
      "when": "POST answer on a question whose status is answered or rejected",
      "status": 409,
      "body": { "detail": "already answered" }
    },
    "approval_pending": {
      "when": "start or recover while an approval question is open or rejected",
      "status": 409,
      "body": { "detail": "approval question pending: answer it in the portal" }
    },
    "task_paused": {
      "when": "the manual PR route on a task with reviewReason needs_input, approval_rejected or plan_review",
      "status": 409,
      "body": { "detail": "task is paused: needs_input" }
    },
    "question_not_found": {
      "when": "the qid is unknown, malformed, or belongs to another task",
      "status": 404,
      "body": { "detail": "question not found" }
    },
    "invalid_answer": {
      "when": "answer is not one of the choices, answer sent to an approval question, or decision sent to a factual question",
      "status": 422,
      "body": { "detail": "answer must be one of the choices" }
    }
  },

