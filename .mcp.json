{
  "mcpServers": {
    "aifactory": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/scripts/start-aifactory-mcp.sh"
      ],
      "env": {
        "AIFACTORY_PROJECT_DIR": "${CLAUDE_PROJECT_DIR:-.}",
        "AIFACTORY_API_URL": "http://localhost:3101",
        "AIFACTORY_API_TOKEN_FILE": "~/.aifactory/.token"
      }
    }
  }
}
