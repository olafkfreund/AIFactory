{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/public/app/features/dashboard/schemas/dashboard.json",
  "title": "AIFactory v1.0",
  "uid": "aifactory-v1",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["aifactory", "enterprise"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total{job=\"aifactory\"}[1m]))",
          "legendFormat": "{{ handler }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "p50 / p99 latency (s)",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"aifactory\"}[5m])))",
          "legendFormat": "p50 {{ handler }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"aifactory\"}[5m])))",
          "legendFormat": "p99 {{ handler }}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (5xx %)",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {"x": 0, "y": 8, "w": 6, "h": 6},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 5, "color": "red"}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{job=\"aifactory\", status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"aifactory\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent task throughput",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 6, "y": 8, "w": 6, "h": 6},
      "description": "Rate of agent-task start / end / result events from the audit log (P5).",
      "targets": [
        {
          "expr": "sum by (action) (rate(http_requests_total{job=\"aifactory\", handler=~\"/api/tasks.*\"}[1m]))",
          "legendFormat": "{{ action }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Audit write rate",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"aifactory\", handler=~\"/api/orgs/.*/audit\", method=\"POST\"}[1m]))",
          "legendFormat": "audit_writes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "OIDC login success / failure",
      "type": "timeseries",
      "datasource": "${datasource}",
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"aifactory\", handler=\"/api/auth/oidc/callback\"}[5m]))",
          "legendFormat": "callback {{ status }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Active in-flight requests",
      "type": "stat",
      "datasource": "${datasource}",
      "gridPos": {"x": 0, "y": 14, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(http_requests_inprogress{job=\"aifactory\"})",
          "refId": "A"
        }
      ]
    }
  ]
}
