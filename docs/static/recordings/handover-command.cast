[0.013, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.000, "o", "\u001b[36m\u001b[1m━━━ AIFactory · the /handover command ━━━\u001b[0m\r\n"]
[1.003, "o", "\r\n\u001b[2m# You're a developer in your repo, mid-conversation with Claude Code.\u001b[0m\r\n\u001b[2m# You've just described a small feature. Instead of building it now,\u001b[0m\r\n"]
[0.000, "o", "\u001b[2m# you hand it to AIFactory's autonomous pipeline — one command.\u001b[0m\r\n"]
[2.004, "o", "\r\n\u001b[35molaf@dev\u001b[0m \u001b[2m~/tmp/aifactory-demo\u001b[0m\r\n\u001b[32m❯\u001b[0m "]
[0.000, "o", "claude"]
[0.504, "o", "\r\n"]
[1.003, "o", "\u001b[2m  (Claude Code session — type a slash command)\u001b[0m\r\n"]
[1.003, "o", "\r\n\u001b[36m\u001b[1m> /handover\u001b[0m \u001b[1mAdd a /uptime endpoint returning process uptime seconds, with a test\u001b[0m\r\n"]
[2.003, "o", "\r\n\u001b[2m  …Claude runs the handover skill…\u001b[0m\r\n"]
[1.041, "o", "\u001b[32m✓\u001b[0m Matched project \u001b[1maifactory-demo\u001b[0m \u001b[2m(/tmp/aifactory-demo)\u001b[0m\r\n"]
[0.604, "o", "\u001b[32m✓\u001b[0m Created task \u001b[1m004-add-uptime-endpoint\u001b[0m and handed it to AIFactory\r\n"]
[0.603, "o", "\u001b[32m✓\u001b[0m Track it in the portal: \u001b[36mhttp://localhost:3100\u001b[0m\r\n"]
[1.203, "o", "\r\n"]
[0.002, "o", "\u001b[1mWhat happens now — without you:\u001b[0m\r\n  \u001b[2mplanner\u001b[0m  writes the spec + subtask plan\r\n  \u001b[33m⏸  pauses at a review gate\u001b[0m \u001b[2m— you approve the plan\u001b[0m\r\n  \u001b[2mcoder\u001b[0m    implements each subtask in an isolated git worktree\r\n  \u001b[2mQA\u001b[0m       validates the acceptance criteria + runs the tests\r\n  \u001b[33m⏸  pauses again\u001b[0m \u001b[2m— a merge-ready diff waits for your review\u001b[0m\r\n"]
[2.504, "o", "\r\n\u001b[1mYour part:\u001b[0m 1 conversation, \u001b[36m1 /handover\u001b[0m, 1 plan approval, 1 review.\r\n\u001b[2mGo work on something else — come back to a finished, merge-ready branch.\u001b[0m\r\n"]
[2.003, "o", "\r\n\u001b[36m\u001b[1m━━━ that's /handover ━━━\u001b[0m\r\n"]
[1.004, "x", "0"]
