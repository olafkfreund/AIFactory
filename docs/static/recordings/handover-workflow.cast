[1.003, "o", "\r\n\u001b[36m\u001b[1m━━━ Step 2 — the GitHub issue ━━━\u001b[0m\r\n\r\n"]
[1.004, "o", "\u001b[2m# A real issue lives at https://github.com/olafkfreund/aifactory-demo/issues/6\u001b[0m\r\n"]
[0.603, "o", "\u001b[2m# Title: 'Document the Quick Start in README'\u001b[0m\r\n"]
[0.603, "o", "\u001b[2m#   — the demo's existing spec walks through this end-to-end.\u001b[0m\r\n"]
[1.608, "o", "\r\n  ┌─────────────────────────────────────────────────────────────┐\r\n  │ Document the Quick Start in README                       #6 │\r\n  ├─────────────────────────────────────────────────────────────┤\r\n  │ Add a Quick Start section showing the three commands a new  │\r\n  │ user runs to bring the app up locally:                      │\r\n  │   pip install -e .                                          │\r\n  │   uvicorn src.app.main:app --reload                         │\r\n  │   curl http://localhost:8000/                               │\r\n  └─────────────────────────────────────────────────────────────┘\r\n\r\n"]
[2.004, "o", "\r\n\u001b[36m\u001b[1m━━━ Step 3 — /handover in Claude Code ━━━\u001b[0m\r\n\r\n"]
[1.005, "o", "\u001b[1mIn a Claude Code session in this repo, the developer types:\u001b[0m\r\n\r\n  \u001b[36m/handover\u001b[0m\r\n\r\nThe skill at \u001b[1m.claude/skills/handover/SKILL.md\u001b[0m reads the recent\r\nconversation, calls \u001b[1mmcp__aifactory__task_create_and_run\u001b[0m, and\r\nreturns a portal URL.  AIFactory's autonomous pipeline takes it\r\nfrom there.\r\n\r\n"]
