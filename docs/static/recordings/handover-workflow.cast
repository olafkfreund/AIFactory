{"version":3,"term":{"cols":80,"rows":24},"timestamp":1779867573,"idle_time_limit":2.0,"command":"bash /home/olafkfreund/Source/GitHub/AIFactory/scripts/record-handover-demo.sh","title":"AIFactory — terminal handover workflow (clone → /handover → PR)","env":{"SHELL":"/run/current-system/sw/bin/zsh"}}
[0.011, "o", "\r\n\u001b[36m\u001b[1m━━━ AIFactory — terminal handover workflow ━━━\u001b[0m\r\n\r\n"]
[1.005, "o", "\u001b[1mThe 60-second story:\u001b[0m\r\n  A developer wants to ship a feature.  They use Claude Code to write\r\n  the spec, then type \u001b[1m/handover\u001b[0m to send it to AIFactory's\r\n  autonomous pipeline.  AIFactory plans → codes → QAs → opens a PR.\r\n  The developer comes back to a merge-ready branch.\r\n\r\nThis recording walks the workflow using artifacts from a real\r\ncompleted run — every JSON / markdown shown was produced by an\r\nagent build that finished earlier today.\r\n"]
[3.003, "o", "\r\n\u001b[36m\u001b[1m━━━ Step 1 — clone the demo repo ━━━\u001b[0m\r\n\r\n"]
